{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "NODE_ENV",
    "PORT",
    "APP_VERSION",
    "API_URL",
    "DATABASE_URL",
    "DATABASE_TLS",
    "DATABASE_CA_CERT",
    "LOG_LEVEL",
    "LOG_FORMAT",
    "TRUST_PROXY",
    "SHUTDOWN_TIMEOUT_MS",
    "SENTRY_DSN",
    "SENTRY_ENVIRONMENT",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_RELEASE",
    "DEBUG_PAGES_ENABLED",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}

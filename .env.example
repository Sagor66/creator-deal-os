# Copy to .env (git-ignored) and replace every "change-me" value.
# Local development only: production values live in the hosting platform's secret
# store, never in a file (CLAUDE.md rule 7). `pnpm dev` loads this file into the API.

# --- Local services (compose.yaml) ---
MYSQL_DATABASE=creator_deal_os
MYSQL_USER=app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_PORT=3306
REDIS_PORT=6379

# --- API (apps/api, validated in src/config/env.ts) ---
# Required. Same user, password and database as above.
DATABASE_URL=mysql://app:change-me@127.0.0.1:3306/creator_deal_os
# development | test | production (default development)
NODE_ENV=development
# HTTP port (default 3001)
PORT=3001
# Reported by GET /meta and on every log line; deploys set the git SHA (default dev)
APP_VERSION=dev
# fatal | error | warn | info | debug | trace | silent (default: debug in development, info in production)
# LOG_LEVEL=debug
# pretty | json (default: pretty in development, json otherwise)
# LOG_FORMAT=pretty
# true behind a load balancer, so client IPs and https are read correctly (default false)
TRUST_PROXY=false
# How long graceful shutdown may take before forcing exit 1 (default 10000, 1000-60000)
SHUTDOWN_TIMEOUT_MS=10000
# TLS to MySQL: off | verify (default: verify in production, off otherwise). There is
# no "encrypt without verifying" mode. Local compose MySQL needs neither variable.
# DATABASE_TLS=off
# PEM of the CA that signed the server's certificate (deployed: from Secret Manager)
# DATABASE_CA_CERT=

# --- Web (apps/web, validated in src/env.schema.ts) ---
# Where the web server reaches the API (default http://localhost:3001)
# API_URL=http://localhost:3001

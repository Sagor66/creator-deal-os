# Copy to .env (git-ignored) and replace every "change-me" value.
# These are for the local Docker services only; production secrets live in the
# hosting platform's secret store, never in a file (CLAUDE.md rule 7).

# --- Local services (compose.yaml) ---
MYSQL_DATABASE=creator_deal_os
MYSQL_USER=app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_PORT=3306
REDIS_PORT=6379

# --- API (apps/api) --- optional, defaults shown
# PORT=3001
# APP_VERSION=dev

# --- Web (apps/web) --- optional, default shown
# API_URL=http://localhost:3001

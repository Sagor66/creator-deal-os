{
  "name": "@cdo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --env-file ../../.env",
    "start": "node dist/main.js",
    "db:migrate": "node --env-file=../../.env dist/database/migrate.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cdo/schemas": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "drizzle-orm": "0.45.3",
    "mysql2": "3.24.5",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cdo/config": "workspace:*",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "eslint": "catalog:",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
